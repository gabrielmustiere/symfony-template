<!DOCTYPE html>
<html lang="fr" class="h-full bg-white dark:bg-gray-950">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Symfony Template{% endblock %}</title>
    <link rel="icon"
          href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><rect width=%22128%22 height=%22128%22 rx=%2224%22 fill=%22%23111111%22/><text y=%221.05em%22 x=%220.5em%22 text-anchor=%22middle%22 font-family=%22sans-serif%22 font-size=%2272%22 font-weight=%22700%22 fill=%22%238B5CF6%22>sf</text></svg>">
    {% block stylesheets %}{% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="h-full bg-white font-body text-gray-800 antialiased dark:bg-gray-950 dark:text-gray-200">

{# Mobile drawer toggle button (top-left) — controlled by Flowbite drawer #}
<nav class="fixed top-0 z-30 w-full border-b border-gray-200 bg-white px-4 py-2.5 dark:border-gray-800 dark:bg-gray-950 lg:hidden">
    <div class="flex items-center justify-between">
        <button data-drawer-target="paper-sidebar" data-drawer-toggle="paper-sidebar" aria-controls="paper-sidebar"
                type="button"
                class="inline-flex items-center rounded-md p-2 text-sm text-gray-500 hover:bg-gray-100 focus:ring-2 focus:ring-gray-200 focus:outline-none dark:text-gray-400 dark:hover:bg-gray-800">
            <span class="sr-only">Ouvrir le menu</span>
            <twig:ux:icon name="tabler:menu-2" class="size-6"/>
        </button>
        <a href="{{ path('app_page') }}" class="flex items-center gap-2">
            <span class="grid size-7 place-items-center rounded-md bg-gray-900 font-display text-xs font-bold text-violet-400 dark:bg-violet-500 dark:text-gray-900">sf</span>
            <span class="font-display text-base font-semibold tracking-tight text-gray-900 dark:text-white">Paper</span>
        </a>
        <div class="w-10"></div>
    </div>
</nav>

{# Sidebar — Flowbite drawer on mobile, static on lg+ #}
<aside id="paper-sidebar"
       class="fixed top-0 left-0 z-40 h-screen w-64 -translate-x-full border-r border-gray-200 bg-white transition-transform dark:border-gray-800 dark:bg-gray-950 lg:translate-x-0"
       aria-label="Sidebar">
    <div class="flex h-full flex-col px-4 py-5">
        <a href="{{ path('app_page') }}" class="mb-8 flex items-center gap-2.5 px-2">
            <span class="grid size-9 place-items-center rounded-lg bg-gray-900 font-display text-sm font-bold text-violet-400 dark:bg-violet-500 dark:text-gray-900">sf</span>
            <div class="leading-tight">
                <div class="font-display text-base font-semibold tracking-tight text-gray-900 dark:text-white">Paper</div>
                <div class="text-2xs uppercase tracking-wider text-gray-500 dark:text-gray-400">Symfony 8 · Flowbite 4</div>
            </div>
        </a>

        <nav class="flex-1">
            <p class="px-2 pb-2 text-2xs font-semibold uppercase tracking-wider text-gray-400">Workspace</p>
            <ul class="space-y-1">
                <li>
                    <a href="{{ path('app_page') }}"
                       class="group flex items-center gap-3 rounded-md bg-violet-50 px-3 py-2 text-sm font-medium text-violet-700 dark:bg-violet-500/10 dark:text-violet-300">
                        <twig:ux:icon name="tabler:layout-dashboard" class="size-5"/>
                        Tableau de bord
                    </a>
                </li>
                <li>
                    <a href="#"
                       class="group flex items-center gap-3 rounded-md px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-900 dark:hover:text-white">
                        <twig:ux:icon name="tabler:files" class="size-5 text-gray-400"/>
                        Documents
                    </a>
                </li>
                <li>
                    <a href="#"
                       class="group flex items-center gap-3 rounded-md px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-900 dark:hover:text-white">
                        <twig:ux:icon name="tabler:users" class="size-5 text-gray-400"/>
                        Utilisateurs
                    </a>
                </li>
                <li>
                    <a href="#"
                       class="group flex items-center gap-3 rounded-md px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-900 dark:hover:text-white">
                        <twig:ux:icon name="tabler:chart-bar" class="size-5 text-gray-400"/>
                        Statistiques
                    </a>
                </li>
            </ul>

            <p class="mt-8 px-2 pb-2 text-2xs font-semibold uppercase tracking-wider text-gray-400">Système</p>
            <ul class="space-y-1">
                <li>
                    <a href="#"
                       class="group flex items-center gap-3 rounded-md px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-900 dark:hover:text-white">
                        <twig:ux:icon name="tabler:settings" class="size-5 text-gray-400"/>
                        Paramètres
                    </a>
                </li>
                <li>
                    <a href="#"
                       class="group flex items-center gap-3 rounded-md px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-900 dark:hover:text-white">
                        <twig:ux:icon name="tabler:help" class="size-5 text-gray-400"/>
                        Documentation
                    </a>
                </li>
            </ul>
        </nav>

        {# User card — bottom of sidebar #}
        <div class="mt-auto border-t border-gray-200 pt-4 dark:border-gray-800">
            {% if app.user %}
                <button id="paper-user-menu-btn" data-dropdown-toggle="paper-user-menu" data-dropdown-placement="top"
                        type="button"
                        class="flex w-full items-center gap-3 rounded-md px-2 py-2 text-left hover:bg-gray-50 dark:hover:bg-gray-900">
                    <span class="grid size-9 shrink-0 place-items-center rounded-full bg-gray-900 text-sm font-semibold text-white dark:bg-violet-500">
                        {{ app.user.userIdentifier|first|upper }}
                    </span>
                    <span class="min-w-0 flex-1">
                        <span class="block truncate text-sm font-medium text-gray-900 dark:text-white">{{ app.user.userIdentifier }}</span>
                        <span class="block truncate text-xs text-gray-500">Connecté</span>
                    </span>
                    <twig:ux:icon name="tabler:dots-vertical" class="size-4 text-gray-400"/>
                </button>
                <div id="paper-user-menu"
                     class="z-50 hidden w-56 divide-y divide-gray-100 rounded-lg border border-gray-200 bg-white shadow-lg dark:divide-gray-700 dark:border-gray-700 dark:bg-gray-900">
                    <div class="px-4 py-3 text-sm">
                        <div class="font-medium text-gray-900 dark:text-white">{{ app.user.userIdentifier }}</div>
                        <div class="truncate text-xs text-gray-500">Compte utilisateur</div>
                    </div>
                    <ul class="py-2 text-sm text-gray-700 dark:text-gray-300">
                        <li><a href="#" class="flex items-center gap-2 px-4 py-2 hover:bg-gray-50 dark:hover:bg-gray-800"><twig:ux:icon name="tabler:user" class="size-4"/> Profil</a></li>
                        <li><a href="#" class="flex items-center gap-2 px-4 py-2 hover:bg-gray-50 dark:hover:bg-gray-800"><twig:ux:icon name="tabler:settings" class="size-4"/> Paramètres</a></li>
                    </ul>
                    <div class="py-2">
                        <a href="{{ path('app_logout') }}"
                           class="flex items-center gap-2 px-4 py-2 text-sm text-rose-700 hover:bg-rose-50 dark:text-rose-300 dark:hover:bg-rose-900/30">
                            <twig:ux:icon name="tabler:logout" class="size-4"/> Déconnexion
                        </a>
                    </div>
                </div>
            {% else %}
                <a href="{{ path('app_login') }}"
                   class="flex items-center justify-center gap-2 rounded-md bg-gray-900 px-3 py-2 text-sm font-medium text-white hover:bg-gray-800 dark:bg-violet-500 dark:hover:bg-violet-400">
                    <twig:ux:icon name="tabler:login" class="size-4"/> Se connecter
                </a>
            {% endif %}
        </div>
    </div>
</aside>

<div class="lg:pl-64">
    <main class="min-h-screen pt-16 lg:pt-0">
        <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-10 lg:py-10">
            {% block body %}{% endblock %}
        </div>
    </main>
</div>

{% include 'common/flash-messages.html.twig' %}

</body>
</html>
